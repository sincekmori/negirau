{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "negirau",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/client-ts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "packages/client-py/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "json",
          "path": "packages/mcp-server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/mcp-server/server.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/mcp-server/server.json",
          "jsonpath": "$.packages[0].version"
        }
      ]
    }
  }
}
