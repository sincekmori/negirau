{
  "name": "negirau",
  "version": "0.3.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run generate:openapi && bun run generate:llms && wrangler types --strict-vars=false && react-router build",
    "preview": "vite preview --port 4173",
    "check": "bun run generate:openapi && bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run a11y && bun run knip && bun run check:drift && bun run check:skill && typos",
    "check:skill": "skills-ref validate skills/negirau",
    "check:drift": "bun run generate:skill && git diff --exit-code -- skills/negirau",
    "typecheck": "wrangler types --strict-vars=false && react-router typegen && tsc",
    "gen": "wrangler types --strict-vars=false",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "generate:llms": "bun run scripts/generate-llms.ts",
    "generate:skill": "bun run scripts/generate-skill.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply negirau --local",
    "db:seed": "wrangler d1 execute negirau --local --file=scripts/seed/dev-seed.sql",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dev": "CLOUDFLARE_ENV=dev bun run build && wrangler deploy && bun run build",
    "ops": "bun run scripts/ops.ts",
    "smoke": "bun run scripts/smoke.ts",
    "a11y": "bun run scripts/a11y.ts"
  },
  "dependencies": {
    "isbot": "^5.2.2",
    "maplibre-gl": "^6.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "uqr": "^0.1.3",
    "workers-og": "^0.0.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "knip": "^6.43.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "^1.16.0",
    "playwright": "^1.64.1",
    "skills-ref": "^0.1.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-babel": "^1.7.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
