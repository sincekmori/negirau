root = true

# House rule: tabs for code, spaces outside TS/JS (see AGENTS.md).
# oxfmt honors these settings unless its own config overrides them, so this
# file stays the single authority on indentation.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
# Render tabs 2 columns wide (matches the JSON/YAML space indent).
tab_width = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

# YAML forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 2
